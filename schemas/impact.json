{
  "$defs": {
    "Detector": {
      "enum": [
        "tree-sitter",
        "rule",
        "regex",
        "runtime"
      ],
      "title": "Detector",
      "type": "string"
    },
    "ImpactState": {
      "enum": [
        "DETECTED",
        "TRIAGED",
        "REPRODUCING",
        "FIXING",
        "VERIFYING",
        "DELIVERED",
        "MERGED",
        "CLOSED",
        "SUPERSEDED",
        "BASELINE_BROKEN",
        "NOT_REPRODUCIBLE",
        "AGENT_FAILED"
      ],
      "title": "ImpactState",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    },
    "UsageKind": {
      "enum": [
        "import",
        "call",
        "config",
        "manifest",
        "url",
        "model_string",
        "runtime"
      ],
      "title": "UsageKind",
      "type": "string"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "detector": {
          "$ref": "#/$defs/Detector"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/UsageKind"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "surface_ref": {
          "title": "Surface Ref",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "commit_sha",
        "file",
        "line",
        "symbol",
        "vendor",
        "surface_ref",
        "kind",
        "confidence",
        "detector"
      ],
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "priority": {
      "title": "Priority",
      "type": "number"
    },
    "repo": {
      "title": "Repo",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "state": {
      "$ref": "#/$defs/ImpactState"
    },
    "usages": {
      "items": {
        "$ref": "#/$defs/UsageRecord"
      },
      "title": "Usages",
      "type": "array"
    }
  },
  "required": [
    "id",
    "contract_id",
    "repo",
    "usages",
    "severity",
    "priority",
    "state",
    "idempotency_key"
  ],
  "title": "Impact",
  "type": "object"
}
